# Rust engine build artifacts
rust/target/
# 桥接 crate 的同步目录：`scripts/prepare_engine.py` 在这里放一份产物，
# 让 FRB 按 rust_root 推出的路径也能加载。
rust/bridge/target/
rust/Cargo.lock.bak
# 插件模板是独立 workspace，构建产物不随仓库分发（测试夹具另行固定）
rust/examples/plugin-template/target/
# 官方规则仓库的构建产物：由 pack_rules 从 rules/*.json 重新生成，
# 不进版本管理（否则改规则时容易忘记重新打包）
rust/dist/

# Rust 引擎构建产物
# cargokit 构建工具的本地产物
rust_builder/cargokit/build_tool/.dart_tool/
rust_builder/cargokit/build_tool/bin/build_tool_runner.dill

# 旧 Go 后端只读参考快照（含独立 git 仓库，按 D5 不进版本管理）
reference/

# macOS 平台构建产物
macos/Pods/
macos/Flutter/ephemeral/

# 工具缓存，非项目源码
.dsh/

# 工具缓存与工作区记忆，非项目源码
.workbuddy/
